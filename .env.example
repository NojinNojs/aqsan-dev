# Canonical site URL (used for sitemaps, canonical tags, and Open Graph previews)
PUBLIC_SITE_URL=https://aqsan.vercel.app

# Contact links used across the site (footer, CTAs, blog bio, services).
# Leave a variable empty to hide that link.

PUBLIC_EMAIL=you@example.com
PUBLIC_GITHUB_URL=https://github.com/username
PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/username
PUBLIC_INSTAGRAM_URL=https://www.instagram.com/username
# Full URL or phone with country code (e.g. 62812xxxxxxx)
PUBLIC_WHATSAPP=62812xxxxxxx
