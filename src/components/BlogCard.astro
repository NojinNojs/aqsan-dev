---
import type { CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;

const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<a href={`/blog/${post.id}`} class="blog-card" data-tilt>
  <div class="card-content">
    <div class="card-meta">
      <div class="date-wrap">
        <Icon name="lucide:calendar" class="meta-icon" />
        <time datetime={post.data.pubDate.toISOString()} class="mono body-sm">
          {formattedDate}
        </time>
      </div>
      {post.data.tags.length > 0 && (
        <span class="tag mono">{post.data.tags[0]}</span>
      )}
    </div>

    <h3 class="heading-3 card-title">{post.data.title}</h3>

    <p class="body-sm card-desc">{post.data.description}</p>

    <div class="read-cta">
      <span class="body-sm">Read article</span>
      <div class="icon-wrap">
        <Icon name="lucide:arrow-right" class="read-arrow" />
      </div>
    </div>
  </div>
  <div class="card-glow" aria-hidden="true"></div>
</a>

<style>
  .blog-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    position: relative;
    border-radius: var(--radius-2xl);
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border);
    transition: all 0.5s var(--ease-out-expo);
    min-height: 320px;
  }

  @media (hover: hover) {
    .blog-card:hover {
      border-color: var(--border-hover);
      box-shadow: 0 20px 40px -10px rgba(0,0,0,0.3);
    }
  }

  .card-content {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--space-xl);
    position: relative;
    z-index: 2;
  }

  .card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-xl);
    color: var(--text-muted);
  }

  .date-wrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .meta-icon {
    width: 14px;
    height: 14px;
    opacity: 0.7;
  }

  .tag {
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
    background: var(--accent-subtle);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-secondary);
    border: 1px solid transparent;
    transition: all 0.3s ease;
  }

  @media (hover: hover) {
    .blog-card:hover .tag {
      border-color: var(--border-hover);
      color: var(--text-primary);
    }
  }

  .card-title {
    margin-bottom: var(--space-sm);
    line-height: 1.3;
    font-size: 1.5rem;
  }

  .card-desc {
    color: var(--text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex-grow: 1;
    margin-bottom: var(--space-xl);
    line-height: 1.6;
  }

  .read-cta {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-top: auto;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-muted);
    transition: color 0.3s ease;
  }

  .icon-wrap {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--bg-primary);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.5s var(--ease-out-expo);
  }

  .read-arrow {
    width: 16px;
    height: 16px;
    transition: transform 0.4s var(--ease-out-expo);
  }

  @media (hover: hover) {
    .blog-card:hover .read-cta {
      color: var(--text-primary);
    }
    
    .blog-card:hover .icon-wrap {
      background: var(--text-primary);
      border-color: var(--text-primary);
    }

    .blog-card:hover .read-arrow {
      color: var(--bg-primary);
      transform: translateX(2px) scale(1.1);
    }
  }

  .card-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 120%, var(--accent-glow) 0%, transparent 60%);
    opacity: 0;
    transition: opacity 0.8s ease;
    pointer-events: none;
    z-index: 1;
  }

  @media (hover: hover) {
    .blog-card:hover .card-glow {
      opacity: 0.6;
    }
  }
</style>

<script>
  import gsap from 'gsap';

  document.addEventListener('astro:page-load', () => {
    if (!window.matchMedia('(hover: hover)').matches) return;

    const cards = document.querySelectorAll('.blog-card[data-tilt]');
    
    cards.forEach(card => {
      const handleMouseMove = (e: any) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left - rect.width / 2;
        const y = e.clientY - rect.top - rect.height / 2;
        
        gsap.to(card, {
          rotateY: x * 0.04,
          rotateX: -y * 0.04,
          transformPerspective: 1000,
          transformOrigin: 'center center',
          ease: 'power2.out',
          duration: 0.5
        });
      };

      const handleMouseLeave = () => {
        gsap.to(card, { rotateY: 0, rotateX: 0, duration: 0.8, ease: 'elastic.out(1, 0.3)' });
      };

      card.addEventListener('mousemove', handleMouseMove);
      card.addEventListener('mouseleave', handleMouseLeave);
    });
  });
</script>
