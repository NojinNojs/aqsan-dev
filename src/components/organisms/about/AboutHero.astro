<script>
  import gsap from 'gsap';
  
  document.addEventListener('astro:page-load', () => {
    const heroSection = document.querySelector('.about-hero');
    if (!heroSection) return;
    
    // Prevent flash of content
    gsap.set(['.ht-1', '.ht-2'], { autoAlpha: 0, y: 40 });
    gsap.set('.gs-reveal', { autoAlpha: 0, y: 20 });
    gsap.set('.hero-bg-glow', { autoAlpha: 0, scale: 0.1 });

    const runHeroEntrance = () => {
      const heroTl = gsap.timeline({ defaults: { ease: 'power3.out', overwrite: 'auto' } });
      
      heroTl
        .to('.ht-1', { autoAlpha: 1, y: 0, duration: 1.0 })
        .to('.ht-2', { autoAlpha: 1, y: 0, duration: 1.0 }, '-=0.7')
        .to('.gs-reveal', { 
          autoAlpha: 1, y: 0, duration: 0.8, stagger: 0.15 
        }, '-=0.5')
        .to('.hero-bg-glow', { 
          autoAlpha: 0.5, scale: 1, duration: 2.0, ease: 'power2.out' 
        }, '-=1.0');
    };

    if (!sessionStorage.getItem('site_loaded')) {
      document.addEventListener('preloader:done', runHeroEntrance, { once: true });
    } else {
      runHeroEntrance();
    }
  });
</script>

