---
import { Icon } from 'astro-icon/components';

interface ToolItem {
  name: string;
  role: string;
  icon: string;
  category: 'frontend' | 'backend' | 'tools';
}

const toolsData: ToolItem[] = [
  // Frontend
  { name: 'React', role: 'UI Library', icon: 'simple-icons:react', category: 'frontend' },
  { name: 'Next.js', role: 'SSR & Fullstack', icon: 'simple-icons:nextdotjs', category: 'frontend' },
  { name: 'TypeScript', role: 'Type Safety', icon: 'simple-icons:typescript', category: 'frontend' },
  { name: 'Tailwind CSS', role: 'Design System', icon: 'simple-icons:tailwindcss', category: 'frontend' },
  { name: 'Astro', role: 'Content & Perf', icon: 'simple-icons:astro', category: 'frontend' },
  { name: 'GSAP', role: 'Motion & Scroll', icon: 'lucide:sparkles', category: 'frontend' },

  // Backend & Systems
  { name: 'Node.js', role: 'Runtime', icon: 'simple-icons:nodedotjs', category: 'backend' },
  { name: 'Express', role: 'REST APIs', icon: 'simple-icons:express', category: 'backend' },
  { name: 'Laravel', role: 'PHP Framework', icon: 'simple-icons:laravel', category: 'backend' },
  { name: 'Rust', role: 'Systems / Learning', icon: 'simple-icons:rust', category: 'backend' },
  { name: 'PostgreSQL', role: 'Relational DB', icon: 'simple-icons:postgresql', category: 'backend' },
  { name: 'Supabase', role: 'BaaS & Auth', icon: 'simple-icons:supabase', category: 'backend' },
  { name: 'MySQL', role: 'Database', icon: 'simple-icons:mysql', category: 'backend' },
  { name: 'MongoDB', role: 'Document DB', icon: 'simple-icons:mongodb', category: 'backend' },

  // Tools & Focus Areas
  { name: 'Git', role: 'Version Control', icon: 'simple-icons:git', category: 'tools' },
  { name: 'Docker', role: 'Containers', icon: 'simple-icons:docker', category: 'tools' },
  { name: 'Linux', role: 'Environment', icon: 'simple-icons:linux', category: 'tools' },
  { name: 'Security', role: 'Concepts & Basics', icon: 'lucide:shield-check', category: 'tools' },
  { name: 'Web3', role: 'Smart Contracts / Exploratory', icon: 'lucide:coins', category: 'tools' },
  { name: 'Vercel', role: 'Deployment', icon: 'simple-icons:vercel', category: 'tools' },
  { name: 'Figma', role: 'UI / UX Design', icon: 'simple-icons:figma', category: 'tools' },
  { name: 'REST API', role: 'Integration', icon: 'lucide:network', category: 'tools' },
];

const categories = [
  { id: 'all', label: 'All Tools' },
  { id: 'frontend', label: 'Frontend' },
  { id: 'backend', label: 'Backend & Systems' },
  { id: 'tools', label: 'DevOps & Focus Areas' },
];
---

<section class="section container tools-section" id="tools-section">
  <div class="tools-header gs-reveal-tools">
    <div class="header-content">
      <span class="label">The Arsenal</span>
      <h2 class="heading-1">Tools of<br/>the trade</h2>
      <p class="body-lg tools-subtitle">
        A practical breakdown of the frameworks, databases, and development tooling I use to build web apps, alongside areas I'm actively exploring.
      </p>
    </div>

    <!-- Interactive category filter buttons with Scroll Affordance -->
    <div class="filter-scroll-wrapper">
      <div class="tools-filter" role="tablist" aria-label="Filter tools by category">
        {categories.map((cat, i) => (
          <button 
            class={`filter-btn ${i === 0 ? 'active' : ''}`}
            data-category={cat.id}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
          >
            {cat.label}
          </button>
        ))}
      </div>
    </div>
  </div>

  <!-- Tools Grid -->
  <div class="tools-grid">
    {toolsData.map(tool => (
      <div 
        class="tool-card" 
        data-cat={tool.category}
        data-animate="fade-up"
      >
        <div class="tool-icon-wrapper">
          <Icon name={tool.icon} class="tool-icon" />
        </div>
        <div class="tool-info">
          <div class="tool-name">{tool.name}</div>
          <div class="tool-role">{tool.role}</div>
        </div>
        <div class="tool-card-glow" aria-hidden="true"></div>
      </div>
    ))}
  </div>
</section>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('astro:page-load', () => {
    const section = document.getElementById('tools-section');
    if (!section) return;

    // Header reveal
    gsap.fromTo('.gs-reveal-tools', 
      { y: 35, autoAlpha: 0 }, 
      {
        y: 0, 
        autoAlpha: 1, 
        duration: 0.9, 
        ease: 'power3.out',
        clearProps: 'all',
        scrollTrigger: {
          trigger: '#tools-section',
          start: 'top 85%'
        }
      }
    );

    // ── Horizontal Scroll Mask & Drag-to-Scroll Affordance ──
    const filterContainer = section.querySelector<HTMLElement>('.tools-filter');
    if (filterContainer) {
      const updateMask = () => {
        const hasOverflow = filterContainer.scrollWidth > filterContainer.clientWidth + 2;
        if (!hasOverflow) {
          filterContainer.style.maskImage = 'none';
          filterContainer.style.webkitMaskImage = 'none';
          return;
        }

        const isAtStart = filterContainer.scrollLeft <= 4;
        const isAtEnd = filterContainer.scrollLeft >= (filterContainer.scrollWidth - filterContainer.clientWidth - 4);

        let mask = '';
        if (isAtStart) {
          mask = 'linear-gradient(to right, black 0%, black calc(100% - 36px), transparent 100%)';
        } else if (isAtEnd) {
          mask = 'linear-gradient(to right, transparent 0%, black 36px, black 100%)';
        } else {
          mask = 'linear-gradient(to right, transparent 0%, black 32px, black calc(100% - 32px), transparent 100%)';
        }
        filterContainer.style.maskImage = mask;
        filterContainer.style.webkitMaskImage = mask;
      };

      filterContainer.addEventListener('scroll', updateMask, { passive: true });
      window.addEventListener('resize', updateMask);
      updateMask();

      // Subtle initial hint nudge on mobile
      if (filterContainer.scrollWidth > filterContainer.clientWidth) {
        gsap.to(filterContainer, {
          scrollLeft: 26,
          duration: 0.45,
          delay: 0.7,
          ease: 'power2.out',
          yoyo: true,
          repeat: 1,
          onUpdate: updateMask
        });
      }

      // Mouse drag to scroll
      let isDown = false;
      let startX = 0;
      let scrollLeft = 0;

      filterContainer.addEventListener('mousedown', (e: MouseEvent) => {
        isDown = true;
        filterContainer.classList.add('is-dragging');
        startX = e.pageX - filterContainer.offsetLeft;
        scrollLeft = filterContainer.scrollLeft;
      });

      window.addEventListener('mouseup', () => {
        if (!isDown) return;
        isDown = false;
        filterContainer.classList.remove('is-dragging');
      });

      filterContainer.addEventListener('mousemove', (e: MouseEvent) => {
        if (!isDown) return;
        e.preventDefault();
        const x = e.pageX - filterContainer.offsetLeft;
        const walk = (x - startX) * 1.4;
        filterContainer.scrollLeft = scrollLeft - walk;
        updateMask();
      });
    }

    // ── Buttery Smooth Coordinated Tab Content Transition ──
    const filterBtns = section.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const toolCards = section.querySelectorAll<HTMLElement>('.tool-card');
    const toolsGrid = section.querySelector<HTMLElement>('.tools-grid');
    let isTransitioning = false;

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        if (btn.classList.contains('active') || isTransitioning) return;
        const category = btn.getAttribute('data-category');
        if (!category || !toolsGrid) return;

        // Update active tab button
        filterBtns.forEach(b => {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');

        // Smoothly center the clicked tab in view
        btn.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });

        isTransitioning = true;

        // Step 1: Smoothly fade current cards out (No layout jump)
        gsap.to(toolsGrid, {
          autoAlpha: 0,
          y: -6,
          duration: 0.16,
          ease: 'power2.in',
          onComplete: () => {
            // Step 2: Toggle display states cleanly
            const matchingItems: HTMLElement[] = [];
            toolCards.forEach(card => {
              const cardCat = card.getAttribute('data-cat');
              const shouldShow = category === 'all' || cardCat === category;

              if (shouldShow) {
                card.style.display = 'flex';
                matchingItems.push(card);
              } else {
                card.style.display = 'none';
              }
            });

            // Step 3: Set initial state for matching items
            gsap.set(matchingItems, { autoAlpha: 0, y: 16, scale: 0.98 });

            // Step 4: Stagger matching items in smoothly
            gsap.to(toolsGrid, {
              autoAlpha: 1,
              y: 0,
              duration: 0.2,
              ease: 'power2.out'
            });

            gsap.to(matchingItems, {
              autoAlpha: 1,
              y: 0,
              scale: 1,
              duration: 0.38,
              stagger: 0.04,
              ease: 'power3.out',
              clearProps: 'transform,opacity,visibility',
              onComplete: () => {
                isTransitioning = false;
              }
            });
          }
        });
      });
    });
  });
</script>

<style>
  .tools-section {
    padding-block: var(--space-5xl) var(--space-4xl);
    position: relative;
  }

  .tools-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
    margin-bottom: var(--space-3xl);
  }

  .tools-subtitle {
    max-width: 580px;
    margin-top: var(--space-md);
    color: var(--text-secondary);
  }

  /* Filter buttons */
  .filter-scroll-wrapper {
    position: relative;
    width: fit-content;
    max-width: 100%;
  }

  .tools-filter {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.375rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    width: fit-content;
    max-width: 100%;
    box-shadow: var(--shadow-sm);
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    cursor: grab;
    user-select: none;
    transition: border-color 0.3s ease;
  }

  .tools-filter.is-dragging {
    cursor: grabbing;
    scroll-behavior: auto;
  }

  .tools-filter::-webkit-scrollbar {
    display: none;
  }

  .filter-btn {
    appearance: none;
    border: none;
    background: transparent;
    color: var(--text-secondary);
    padding: 0.5rem 1.15rem;
    border-radius: var(--radius-full);
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
    transition: background-color 0.25s ease, color 0.25s ease, transform 0.15s ease;
  }

  .filter-btn:hover {
    color: var(--text-primary);
  }

  .filter-btn:active {
    transform: scale(0.96);
  }

  .filter-btn.active {
    background: var(--text-primary);
    color: var(--text-inverse);
    box-shadow: var(--shadow-sm);
  }

  /* Grid of tools */
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--space-md);
    position: relative;
  }

  .tool-card {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: 1.125rem 1.25rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), 
                border-color 0.3s ease, 
                box-shadow 0.3s ease;
    overflow: hidden;
    cursor: default;
  }

  .tool-card:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), var(--shadow-glow);
  }

  .tool-icon-wrapper {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    flex-shrink: 0;
    transition: border-color 0.3s ease, transform 0.3s ease;
  }

  .tool-card:hover .tool-icon-wrapper {
    border-color: var(--accent);
    transform: scale(1.05);
  }

  .tool-icon {
    width: 22px;
    height: 22px;
    color: var(--text-primary);
    transition: color 0.3s ease;
  }

  .tool-card:hover .tool-icon {
    color: var(--accent);
  }

  .tool-info {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .tool-name {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.01em;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .tool-role {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    margin-top: 0.125rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .tool-card-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at top right, var(--accent-subtle) 0%, transparent 70%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .tool-card:hover .tool-card-glow {
    opacity: 1;
  }

  /* Responsive Adjustments */
  @media (max-width: 768px) {
    .tools-section {
      padding-block: var(--space-4xl) var(--space-3xl);
    }

    .tools-header {
      gap: var(--space-xl);
      margin-bottom: var(--space-2xl);
    }

    .filter-scroll-wrapper {
      width: 100%;
    }

    .tools-filter {
      width: 100%;
      flex-wrap: nowrap;
      padding: 0.25rem;
    }

    .tools-filter::-webkit-scrollbar {
      display: none;
    }

    .filter-btn {
      white-space: nowrap;
      padding: 0.4rem 0.9rem;
      font-size: 0.75rem;
    }

    .tools-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.75rem;
    }

    .tool-card {
      padding: 0.875rem 1rem;
      gap: 0.75rem;
      border-radius: var(--radius-lg);
    }

    .tool-icon-wrapper {
      width: 36px;
      height: 36px;
      border-radius: var(--radius-md);
    }

    .tool-icon {
      width: 18px;
      height: 18px;
    }

    .tool-name {
      font-size: 0.85rem;
    }

    .tool-role {
      font-size: 0.7rem;
    }
  }

  @media (max-width: 480px) {
    .tools-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.5rem;
    }
    .tool-card {
      padding: 0.75rem 0.85rem;
      gap: 0.5rem;
    }
    .tool-icon-wrapper {
      width: 32px;
      height: 32px;
    }
    .tool-icon {
      width: 16px;
      height: 16px;
    }
    .tool-name {
      font-size: 0.8rem;
    }
    .tool-role {
      font-size: 0.65rem;
    }
  }
</style>
