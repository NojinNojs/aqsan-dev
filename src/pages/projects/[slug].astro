---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';

export async function getStaticPaths() {
  const projectEntries = await getCollection('projects');
  const sorted = projectEntries.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  
  return sorted.map((entry, index) => ({
    params: { slug: entry.id },
    props: { 
      entry,
      prevProject: index > 0 ? sorted[index - 1] : null,
      nextProject: index < sorted.length - 1 ? sorted[index + 1] : null
    },
  }));
}

const { entry, prevProject, nextProject } = Astro.props;
const { Content } = await render(entry);

const formattedDate = entry.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
});
---

<Layout 
  title={`${entry.data.title} | Project Case Study`}
  description={entry.data.description}
>
  <!-- Reading Progress -->
  <div class="reading-progress-container">
    <div class="reading-progress-bar"></div>
  </div>

  <article class="project-post">
    <!-- Hero Section -->
    <header class="post-hero section container">
      <div class="hero-content">
        <div class="nav-breadcrumbs">
          <a href="/projects" class="back-link mono">
            <Icon name="lucide:arrow-left" /> All Projects
          </a>
          <span class="sep">/</span>
          <span class="project-date mono">{formattedDate}</span>
        </div>
        
        <h1 class="display project-title">{entry.data.title}</h1>
        <p class="body-lg subtitle">{entry.data.description}</p>
        
        <div class="meta-grid">
          <div class="meta-item">
            <span class="label">Tech Stack</span>
            <div class="tech-stack">
              {entry.data.techStack.map(tech => (
                <span class="tech mono">{tech}</span>
              ))}
            </div>
          </div>
          
          {entry.data.link && (
            <div class="meta-item meta-actions">
              <span class="label">Source & Preview</span>
              <a href={entry.data.link} target="_blank" rel="noopener noreferrer" class="btn btn-primary magnetic" data-cursor="VISIT">
                View Project <Icon name="lucide:external-link" />
              </a>
            </div>
          )}
        </div>
      </div>
    </header>
    
    <!-- Content Section -->
    <div class="container section pt-0">
      <div class="prose content-prose">
        <Content />
      </div>

      <!-- Project Pagination Nav -->
      <footer class="project-nav-footer">
        <div class="nav-grid">
          {prevProject ? (
            <a href={`/projects/${prevProject.id}`} class="nav-card prev-card">
              <span class="nav-direction mono"><Icon name="lucide:arrow-left" /> Previous Project</span>
              <span class="nav-title">{prevProject.data.title}</span>
            </a>
          ) : <div class="nav-empty"></div>}

          {nextProject ? (
            <a href={`/projects/${nextProject.id}`} class="nav-card next-card">
              <span class="nav-direction mono">Next Project <Icon name="lucide:arrow-right" /></span>
              <span class="nav-title">{nextProject.data.title}</span>
            </a>
          ) : <div class="nav-empty"></div>}
        </div>
      </footer>
    </div>
  </article>
</Layout>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';
  
  gsap.registerPlugin(ScrollTrigger);
  
  document.addEventListener('astro:page-load', () => {
    // ── Safe, Robust Entrance Animation with fromTo + clearProps ──
    const heroContent = document.querySelector('.post-hero');
    if (heroContent) {
      gsap.fromTo('.nav-breadcrumbs', 
        { y: 10, autoAlpha: 0 }, 
        { y: 0, autoAlpha: 1, duration: 0.5, ease: 'power2.out', clearProps: 'all' }
      );
      gsap.fromTo('.project-title', 
        { y: 20, autoAlpha: 0 }, 
        { y: 0, autoAlpha: 1, duration: 0.7, delay: 0.08, ease: 'power3.out', clearProps: 'all' }
      );
      gsap.fromTo('.post-hero .subtitle', 
        { y: 15, autoAlpha: 0 }, 
        { y: 0, autoAlpha: 1, duration: 0.6, delay: 0.15, ease: 'power2.out', clearProps: 'all' }
      );
      gsap.fromTo('.post-hero .meta-grid', 
        { y: 15, autoAlpha: 0 }, 
        { y: 0, autoAlpha: 1, duration: 0.6, delay: 0.22, ease: 'power2.out', clearProps: 'all' }
      );
      gsap.fromTo('.content-prose', 
        { y: 20, autoAlpha: 0 }, 
        { y: 0, autoAlpha: 1, duration: 0.7, delay: 0.3, ease: 'power2.out', clearProps: 'all' }
      );
    }

    // ── Reading Progress Bar ──
    const progressBar = document.querySelector('.reading-progress-bar');
    if (progressBar) {
      gsap.to(progressBar, {
        scaleX: 1,
        ease: 'none',
        scrollTrigger: {
          trigger: '.project-post',
          start: 'top top',
          end: 'bottom bottom',
          scrub: true
        }
      });
    }

    // ── Magnetic button effect ──
    const magneticEls = document.querySelectorAll('.magnetic');
    magneticEls.forEach(el => {
      el.addEventListener('mousemove', (e: any) => {
        const rect = el.getBoundingClientRect();
        const x = (e.clientX - rect.left - rect.width / 2) * 0.2;
        const y = (e.clientY - rect.top - rect.height / 2) * 0.2;
        gsap.to(el, { x, y, duration: 0.4, ease: 'power2.out' });
      });
      el.addEventListener('mouseleave', () => {
        gsap.to(el, { x: 0, y: 0, duration: 0.7, ease: 'elastic.out(1, 0.3)' });
      });
    });
  });
</script>

<style is:global>
  .pt-0 {
    padding-top: 0;
  }

  .post-hero {
    margin-bottom: var(--space-xl);
  }
  
  .nav-breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: var(--space-2xl);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-muted);
    font-size: 0.8125rem;
    transition: color 0.3s ease;
  }

  .back-link:hover {
    color: var(--text-primary);
  }

  .nav-breadcrumbs .sep {
    color: var(--border-hover);
    font-size: 0.75rem;
  }

  .project-date {
    color: var(--text-muted);
    font-size: 0.8125rem;
  }
  
  .subtitle {
    margin: var(--space-lg) 0 var(--space-3xl);
    max-width: 700px;
    color: var(--text-secondary);
    line-height: 1.7;
  }
  
  .meta-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-2xl);
    padding-top: var(--space-2xl);
    border-top: 1px solid var(--border);
  }
  
  .meta-item .label {
    display: block;
    margin-bottom: var(--space-md);
  }
  
  .tech-stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
  
  .tech {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  /* Content typography */
  .content-prose {
    max-width: 820px;
    margin: 0 auto;
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--text-secondary);
  }

  .content-prose h2 {
    color: var(--text-primary);
    margin-top: var(--space-4xl);
    margin-bottom: var(--space-md);
    font-size: 1.875rem;
    letter-spacing: -0.02em;
  }

  .content-prose h3 {
    color: var(--text-primary);
    margin-top: var(--space-2xl);
    margin-bottom: var(--space-sm);
    font-size: 1.35rem;
  }

  .content-prose p {
    margin-bottom: var(--space-lg);
  }

  .content-prose ul {
    margin-bottom: var(--space-xl);
    padding-left: 1.25rem;
  }

  .content-prose li {
    margin-bottom: 0.5rem;
  }

  .content-prose pre {
    border-radius: var(--radius-xl);
    padding: var(--space-xl);
    margin: var(--space-2xl) 0;
    border: 1px solid var(--border);
    background: var(--surface) !important;
    overflow-x: auto;
  }

  /* Project Navigation Footer */
  .project-nav-footer {
    max-width: 820px;
    margin: var(--space-5xl) auto 0;
    padding-top: var(--space-3xl);
    border-top: 1px solid var(--border);
  }

  .nav-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
  }

  .nav-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-xl);
    border-radius: var(--radius-xl);
    background: var(--surface);
    border: 1px solid var(--border);
    transition: all 0.3s ease;
    text-decoration: none;
  }

  .nav-card:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
  }

  .next-card {
    text-align: right;
  }

  .nav-direction {
    font-size: 0.75rem;
    color: var(--text-muted);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: var(--space-xs);
  }

  .next-card .nav-direction {
    justify-content: flex-end;
  }

  .nav-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.3;
  }

  @media (max-width: 768px) {
    .project-title {
      font-size: clamp(1.85rem, 7.5vw, 2.5rem);
      line-height: 1.15;
      letter-spacing: -0.02em;
    }

    .subtitle {
      font-size: 1rem;
      margin: var(--space-md) 0 var(--space-2xl);
    }

    .meta-grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
      padding-top: var(--space-lg);
    }

    .meta-actions .btn {
      width: 100%;
      justify-content: center;
    }

    .content-prose {
      font-size: 1rem;
      line-height: 1.7;
    }

    .content-prose h2 {
      font-size: 1.45rem;
      margin-top: var(--space-3xl);
    }

    .content-prose h3 {
      font-size: 1.2rem;
      margin-top: var(--space-xl);
    }

    .content-prose pre {
      padding: 1rem;
      border-radius: var(--radius-lg);
      font-size: 0.8125rem;
      margin: var(--space-lg) 0;
    }

    .nav-grid {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }

    .next-card {
      text-align: left;
    }

    .next-card .nav-direction {
      justify-content: flex-start;
    }
  }

  /* Reading Progress */
  .reading-progress-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    z-index: 1000;
    background: transparent;
  }
  .reading-progress-bar {
    width: 100%;
    height: 100%;
    background: var(--accent);
    transform-origin: 0% 50%;
    transform: scaleX(0);
  }
</style>
